# Copy to .env next to docker-compose.yaml and fill in. Compose refuses to start
# without the three values that have no safe default.

# --- required ---------------------------------------------------------------
# Postgres password. Used by both the database and the app.
DB_PASSWORD=
# At least 32 characters (HS256). Generate one: openssl rand -base64 48
JWT_SECRET=
# Seeded on first start for ADMIN_EMAIL below.
ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------
# Host port the API is published on; the container always listens on 8080.
APP_PORT=8080

DB_NAME=DdinovsTravel
DB_USER=postgres

ADMIN_EMAIL=admin@ddinovstravel.uz

# Comma-separated. A browser origin missing from this list is refused with 403.
CORS_ORIGINS=https://ddinovstravel.uz,https://www.ddinovstravel.uz

# Contact-form enquiries. With either value missing they are logged, not sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Cloud Translation. With no key the content is served as authored.
TRANSLATION_ENABLED=true
TRANSLATION_API_KEY=
TRANSLATION_SOURCE_LANG=uz

# JVM flags for the container.
JAVA_OPTS=-XX:MaxRAMPercentage=75
